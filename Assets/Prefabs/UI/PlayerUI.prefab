  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In the distant future 2069, humanity has discovered a new technology to
    harvest energy from time. In theory making humans immortal. \r\n\r\nVarious time-fundamentalist
    terrorist groups have emerged. Such as \"The Entropy People's Front\" and its
    rival faction \"The People's Front of Entropy\". These groups wish to destroy
    humanity's great discovery.\r\n\r\nYou play as Rick Dickman, a time officer,
    and your duty is to eradicate these terries. You have limited time left to live.
    But you can turn their souls into time energy and power up your arsenal to protect
    humanity.\n\nTime to die!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 15deb731bf55f0d44bf8d42e6d406451, type: 2}
  m_sharedMaterial: {fileID: 8677901516855808400, guid: 15deb731bf55f0d44bf8d42e6d406451, type: 2}
